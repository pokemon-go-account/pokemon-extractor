# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pokemon_extractor

# Authentication & Security (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
CHECKER_API_KEY=your_checker_sync_api_key_here
ADMIN_INVITE_CODE=your_production_admin_invite_code

# Telegram configuration (for historical messages sync)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
